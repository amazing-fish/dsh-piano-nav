{
  "name": "dsh-piano-nav",
  "description": "Semantic conversation navigation for DeepSeek Harness: full-history turns, questions and answers, collapsible process output, and a continuous pointer-following piano rail.",
  "version": "1.3.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.1 || >=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1 || ^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1 || ^3.18.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "jsdom": "29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "tsx": "^4.20.0",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "docs/README.md",
    "docs/USAGE.md",
    "docs/COMPATIBILITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazing-fish/dsh-piano-nav.git"
  },
  "homepage": "https://github.com/amazing-fish/dsh-piano-nav",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown -c tsdown.host.config.mjs --config-loader tsx && tsdown -c tsdown.client.config.mjs --config-loader tsx && node scripts/wrap-client.mjs",
    "typecheck": "tsc -b",
    "test:contracts": "node --import tsx scripts/chat-source.mjs && node --import tsx scripts/navigation-contract.mjs && node --import tsx scripts/full-history-contract.mjs && node --import tsx scripts/native-navigation-contract.mjs && node --import tsx scripts/semantic-contract.mjs && node --import tsx scripts/semantic-dom.mjs && node --import tsx scripts/pointer-wave.mjs",
    "test": "pnpm test:contracts && node --import tsx scripts/colors-contract.mjs && node --import tsx scripts/color-write-queue.mjs && node --import tsx scripts/color-preview.mjs && node --import tsx scripts/grouping.mjs && node --import tsx scripts/rail-collapse.mjs && node scripts/smoke.mjs && node scripts/integration.mjs",
    "verify": "pnpm build && pnpm test",
    "watch": "tsdown -c tsdown.client.config.mjs --config-loader tsx --watch",
    "prepack": "pnpm build",
    "test:package": "node scripts/package-contract.mjs"
  },
  "author": {
    "name": "amazing-fish",
    "url": "https://github.com/amazing-fish"
  },
  "contributors": [
    {
      "name": "sm-context-piano contributors",
      "url": "https://github.com/hjj345/dsh-sm-context-piano"
    }
  ],
  "bugs": {
    "url": "https://github.com/amazing-fish/dsh-piano-nav/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "conversation",
    "navigation",
    "piano",
    "agent",
    "chat"
  ],
  "packageManager": "pnpm@10.17.1",
  "piano": {
    "displayName": "DSH Piano Navigator",
    "releaseDate": "—"
  }
}
